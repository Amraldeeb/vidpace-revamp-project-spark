---
interface Props { items: { q: string; a: string }[]; heading?: string; }
const { items, heading = "Questions buyers ask" } = Astro.props;
---
<section class="section" id="faq" aria-labelledby="faq-h">
  <div class="wrap">
    <div class="head"><span class="eyebrow">FAQ</span><h2 class="display h2" id="faq-h">{heading}</h2></div>
    <div class="faq">
      {items.map((f, i) => (<details open={i === 0}><summary>{f.q}</summary><p>{f.a}</p></details>))}
    </div>
  </div>
</section>
