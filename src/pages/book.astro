---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import { site } from "../data/site";
---
<Base title="Book a call" description="Book a free 30-minute call with VidPace to plan your YouTube channel.">
  <section class="page-hero">
    <div class="wrap">
      <p class="crumbs"><a href="/">Home</a> / Book a call</p>
      <h1 class="display h1">Book a 30-minute call</h1>
      <p class="lede">We'll look at your channel together, agree goals and recommend one plan. If we're not the right fit, we'll say so.</p>
      <ul class="assure"><li><Icon name="check" />Free</li><li><Icon name="check" />No obligation</li><li><Icon name="check" />Recorded audit included</li></ul>
    </div>
  </section>
  <section class="section tight" style="border-top:0;padding-top:0">
    <div class="wrap">
      <div class="calendly-inline-widget" data-url={`${site.calendly}?hide_gdpr_banner=1&background_color=141212&text_color=f6f3f2&primary_color=e01347`} style="min-width:320px;height:720px;border:1px solid var(--line);border-radius:14px;overflow:hidden"></div>
      <p class="fine" style="margin-top:14px">Calendar not loading? <a href={site.calendly} target="_blank" rel="noopener">Open the booking page</a>.</p>
    </div>
  </section>
  <script is:inline async src="https://assets.calendly.com/assets/external/widget.js"></script>
</Base>
