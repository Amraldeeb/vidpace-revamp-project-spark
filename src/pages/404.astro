---
import Base from "../layouts/Base.astro";
---
<Base title="Page not found">
  <section class="page-hero">
    <div class="wrap">
      <span class="eyebrow">404</span>
      <h1 class="display h1" style="margin-top:14px">This clip got cut</h1>
      <p class="lede">The page you're looking for isn't here.</p>
      <div class="btn-row" style="margin-top:28px"><a class="btn btn-red" href="/">Go to the homepage</a><a class="btn btn-ghost" href="/pricing">See pricing</a></div>
    </div>
  </section>
</Base>
