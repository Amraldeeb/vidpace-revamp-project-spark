{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/schedule", "destination": "/book", "permanent": true },
    { "source": "/contact", "destination": "/#audit", "permanent": true }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
    ] }
  ]
}
